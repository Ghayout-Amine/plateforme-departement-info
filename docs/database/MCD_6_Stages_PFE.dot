graph MCD {
graph [fontname="DejaVu Sans", fontsize=22, labelloc=t, label=<<B>MCD 6/6 — Stages, PFE et offres externes (v02)</B>>, splines=true, overlap=false, nodesep=0.9, ranksep=1.1, pad=0.4, dpi=110];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9.5, color="#37474F", fontcolor="#1A237E", labelfontcolor="#C62828", labelfontsize=9.5, labeldistance=2.2, labelangle=25];
"SOURCE_OFFRES" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>SOURCE_OFFRES</B> <FONT COLOR="#2E7D32" POINT-SIZE="9">[v02]</FONT></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">code</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (30)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">name</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (100)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">website_url</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">access_mode</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (10)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">enabled</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Boolean</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">api_key_ref</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (80)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">sync_interval_minutes</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Short integer</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">default_keywords</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (500)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">default_locations</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (500)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">quota_limit</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Integer</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">quota_period</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (10)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">attribution_text</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">logo_url</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">last_sync_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR></TABLE>>];
"JOURNAL_SYNCHRO" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>JOURNAL_SYNCHRO</B> <FONT COLOR="#2E7D32" POINT-SIZE="9">[v02]</FONT></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">started_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">finished_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">status</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (10)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">fetched_count</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Integer</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">created_count</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Integer</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">updated_count</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Integer</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">expired_count</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Integer</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">quota_remaining</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Integer</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">error_message</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (1000)</TD></TR></TABLE>>];
"OFFRE_EXTERNE" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>OFFRE_EXTERNE</B> <FONT COLOR="#2E7D32" POINT-SIZE="9">[v02]</FONT></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">external_id</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (150)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">title</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">company_name</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (200)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">city</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (100)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">country</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Characters (2)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">contract_type</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (20)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">is_remote</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Boolean</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">snippet</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (1000)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">salary_text</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (150)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">original_url</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (700)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">fingerprint</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Characters (64)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">status</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (10)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">is_featured</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Boolean</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">published_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">expires_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">first_seen_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">last_seen_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR></TABLE>>];
"ALERTE" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>ALERTE</B> <FONT COLOR="#2E7D32" POINT-SIZE="9">[v02]</FONT></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">name</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (100)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">keywords</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">contract_types</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (100)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">city</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (100)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">country</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Characters (2)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">remote_only</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Boolean</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">frequency</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (10)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">active</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Boolean</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">last_notified_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR></TABLE>>];
"SUIVI_CANDIDATURE" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>SUIVI_CANDIDATURE</B> <FONT COLOR="#2E7D32" POINT-SIZE="9">[v02]</FONT></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">position_title</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">company_name</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (200)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">offer_url</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (700)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">status</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (20)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">applied_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">next_step_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">notes</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Text</TD></TR></TABLE>>];
