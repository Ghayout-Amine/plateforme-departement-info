graph MCD {
graph [fontname="DejaVu Sans", fontsize=22, labelloc=t, label=<<B>MCD 1/6 — Sécurité, administration, partie publique et veille (v02)</B>>, splines=true, overlap=false, nodesep=0.9, ranksep=1.1, pad=0.4, dpi=110];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=9.5, color="#37474F", fontcolor="#1A237E", labelfontcolor="#C62828", labelfontsize=9.5, labeldistance=2.2, labelangle=25];
"UTILISATEUR" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>UTILISATEUR</B></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">email</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (150)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">password_hash</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">first_name</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (80)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">last_name</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (80)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">phone</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (30)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">avatar_url</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">enabled</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Boolean</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">last_login_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">deleted_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR></TABLE>>];
"ROLE" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>ROLE</B></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">name</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (50)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">description</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR></TABLE>>];
"PERMISSION" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>PERMISSION</B></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">code</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (80)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">description</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR></TABLE>>];
"JETON" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>JETON</B></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">token_type</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (20)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">token_hash</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">expires_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">revoked_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR></TABLE>>];
"JOURNAL_ACTIVITE" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>JOURNAL_ACTIVITE</B></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">action</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (80)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">entity_type</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (80)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">entity_id</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Long integer</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">details</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Text</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">ip_address</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (45)</TD></TR></TABLE>>];
"PARAMETRE_SYSTEME" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>PARAMETRE_SYSTEME</B></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">param_key</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (100)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">param_value</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (1000)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">description</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR></TABLE>>];
"ACTUALITE" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>ACTUALITE</B> <FONT COLOR="#2E7D32" POINT-SIZE="9">[v02]</FONT></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">title</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (200)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">slug</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (220)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">summary</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (500)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">content</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Text</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">category</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (20)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">visibility</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (20)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">status</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (20)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">is_pinned</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Boolean</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">cover_image_url</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (255)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">published_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR></TABLE>>];
"MESSAGE_CONTACT" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>MESSAGE_CONTACT</B></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">full_name</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (150)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">email</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (150)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">subject</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (200)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">message</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Text</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">status</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (20)</TD></TR></TABLE>>];
"FLUX_ACTUALITES" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>FLUX_ACTUALITES</B> <FONT COLOR="#2E7D32" POINT-SIZE="9">[v02]</FONT></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">name</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (150)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">feed_url</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (500)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">feed_type</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (10)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">category</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (20)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">enabled</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Boolean</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">sync_interval_minutes</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Short integer</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">last_sync_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">last_status</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (10)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">last_error</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (500)</TD></TR></TABLE>>];
"ARTICLE_EXTERNE" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>ARTICLE_EXTERNE</B> <FONT COLOR="#2E7D32" POINT-SIZE="9">[v02]</FONT></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">title</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (300)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">summary</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (1000)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">image_url</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (500)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">original_url</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (700)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">url_hash</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Characters (64)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">author</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (150)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">category</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (20)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">status</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (10)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">published_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">fetched_at</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Date &amp; time</TD></TR></TABLE>>];
"ABONNEMENT" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFFFCC" COLOR="black"><TR><TD COLSPAN="3" BGCOLOR="#FFFFCC" SIDES="B"><B>ABONNEMENT</B> <FONT COLOR="#2E7D32" POINT-SIZE="9">[v02]</FONT></TD></TR><TR><TD ALIGN="LEFT" SIDES="B"><U>id</U></TD><TD ALIGN="LEFT" SIDES="B">Long integer</TD><TD ALIGN="RIGHT" SIDES="B">&lt;pi&gt;</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">category</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (20)</TD></TR><TR><TD ALIGN="LEFT" BORDER="0">channel</TD><TD ALIGN="LEFT" BORDER="0" COLSPAN="2">Variable characters (10)</TD></TR></TABLE>>];
"UTILISATEUR" -- "ROLE" [label=<<I>POSSEDE_ROLE</I>>, taillabel="1,n", headlabel="0,n"];
"ROLE" -- "PERMISSION" [label=<<I>ACCORDE</I>>, taillabel="0,n", headlabel="0,n"];
