@startuml
title Cas d'utilisation — Administrateur (v02)
skinparam dpi 120
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam usecaseBackgroundColor #FFFDE7
skinparam usecaseBorderColor #F9A825
skinparam ArrowColor #455A64
skinparam actorBackgroundColor #E3F2FD
skinparam actorBorderColor #1565C0
skinparam rectangleBackgroundColor #FAFAFA
skinparam rectangleBorderColor #607D8B
skinparam packageStyle rectangle
skinparam noteBackgroundColor #FFF8E1
skinparam noteBorderColor #BCAAA4
left to right direction
actor "Administrateur" as A
rectangle "Plateforme de Gestion du Département Informatique" {
  package "Gestion des comptes" {
    usecase "Créer un utilisateur" as U1
    usecase "Modifier un utilisateur" as U2
    usecase "Désactiver un compte" as U3
    usecase "Supprimer un compte" as U4
    usecase "Réinitialiser un mot de passe" as U5
    usecase "Attribuer un rôle" as U6
  }
  package "Sécurité" {
    usecase "Gérer les permissions" as S1
    usecase "Consulter les journaux d'activité" as S2
  }
  package "Système" {
    usecase "Gérer certains paramètres du système" as Y1
    usecase "Consulter le tableau de bord d'administration" as Y2
    usecase "Consulter les utilisateurs actifs\net les comptes désactivés" as Y3
    usecase "Consulter la répartition des rôles" as Y4
    usecase "Consulter les activités récentes" as Y5
  }
  package "Intégrations externes" {
    usecase "Déclarer les clés d'API\n(référence à une variable d'environnement)" as I1
    usecase "Consulter les journaux\nde synchronisation" as I2
    usecase "Surveiller les quotas d'API" as I3
    usecase "Relancer une synchronisation" as I4
  }
}
A --> U1
A --> U2
A --> U3
A --> U4
A --> U5
A --> S1
A --> S2
A --> Y1
A --> Y2
A --> I1
A --> I2
A --> I4
U1 ..> U6 : <<include>>
U6 .> U2 : <<extend>>
Y2 ..> Y3 : <<include>>
Y2 ..> Y4 : <<include>>
Y2 ..> Y5 : <<include>>
I2 ..> I3 : <<include>>
note bottom of A
  Tous les cas nécessitent « S'authentifier »
  avec le rôle ROLE_ADMIN.
  Les clés d'API ne sont jamais stockées
  en base ni exposées au frontend.
end note
@enduml
