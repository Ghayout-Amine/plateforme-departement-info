@startuml
title Diagramme de cas d'utilisation — Vue globale de la plateforme (v02)
skinparam dpi 120
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam usecaseBackgroundColor #FFFDE7
skinparam usecaseBorderColor #F9A825
skinparam ArrowColor #455A64
skinparam actorBackgroundColor #E3F2FD
skinparam actorBorderColor #1565C0
skinparam rectangleBackgroundColor #FAFAFA
skinparam rectangleBorderColor #607D8B
skinparam packageStyle rectangle
skinparam noteBackgroundColor #FFF8E1
skinparam noteBorderColor #BCAAA4
left to right direction
actor "Visiteur" as V
actor "Étudiant" as E
actor "Enseignant" as T
actor "Responsable\ndu département" as R
actor "Administrateur" as A
actor "Utilisateur\nauthentifié" as UA
actor "Services externes\n(API emploi,\nflux RSS/API actualités)" as X <<système>>
E --|> UA
T --|> UA
R --|> UA
A --|> UA
rectangle "Plateforme de Gestion du Département Informatique" {
  usecase "Consulter la partie publique" as P1
  usecase "S'authentifier" as AUTH
  usecase "Administrer utilisateurs,\nrôles, permissions et clés d'API" as ADM
  usecase "Gérer la structure pédagogique\n(formations, filières, modules, groupes, salles)" as PED
  usecase "Gérer emplois du temps et examens" as EDT
  usecase "Gérer étudiants et enseignants" as PERS
  usecase "Gérer actualités, annonces\net flux de veille" as NEWS
  usecase "Gérer ressources, notes et absences" as ENS
  usecase "Consulter son espace étudiant\n(profil, emploi du temps, résultats, absences)" as ESP
  usecase "Rechercher des offres de stage,\nPFE et emploi (agrégées)" as OFF
  usecase "Suivre ses candidatures\net déclarer son stage/PFE" as CAND
  usecase "Configurer les sources d'offres" as SRC
  usecase "Valider et suivre les stages/PFE\n(encadrants, soutenances)" as PFE
  usecase "Synchroniser offres et actualités" as SYNC
  usecase "Consulter les statistiques" as STAT
}
V --> P1
UA --> AUTH
A --> ADM
R --> PED
R --> EDT
R --> PERS
R --> NEWS
T --> ENS
E --> ESP
E --> OFF
E --> CAND
R --> SRC
R --> PFE
T --> PFE
R --> STAT
A --> STAT
SYNC <-- X
note bottom of X
  Les entreprises n'ont plus de compte :
  les offres proviennent d'API externes
  (Jooble, Careerjet, JSearch, France Travail…)
  ou d'une saisie du département ;
  la synchronisation alimente la recherche
  d'offres et le fil d'actualités.
end note
@enduml
