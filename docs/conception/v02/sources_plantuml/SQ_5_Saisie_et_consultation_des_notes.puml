@startuml
title Séquence — Saisie, publication et consultation des notes
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #37474F
skinparam sequenceArrowThickness 1.1
skinparam participantBackgroundColor #E3F2FD
skinparam participantBorderColor #1565C0
skinparam actorBackgroundColor #E3F2FD
skinparam actorBorderColor #1565C0
skinparam boundaryBackgroundColor #E8F5E9
skinparam controlBackgroundColor #FFF8E1
skinparam databaseBackgroundColor #FFF3E0
skinparam sequenceGroupBackgroundColor #F5F5F5
skinparam sequenceDividerBackgroundColor #ECEFF1
skinparam noteBackgroundColor #FFF8E1
skinparam maxMessageSize 220
autonumber

actor "Enseignant" as T
actor "Étudiant" as E
boundary "Angular" as FE
control "GradeController" as GC
control "GradeService" as GS
participant "TeachingAssignment\nRepository" as TAR
participant "EnrollmentRepository" as ER
participant "GradeRepository" as GR
participant "AuditService" as AU
database "MySQL" as DB

== Saisie des notes (enseignant) ==
T -> FE : ouvre une évaluation de son module
FE -> GC : GET /api/examens/{id}/students
GC -> GS : listStudents(examId, teacherId)
GS -> ER : findEnrolledStudents(module, année)
ER -> DB : SELECT enrollments + students + filiere_modules
GC --> FE : liste des étudiants concernés
T -> FE : saisit les notes (0 à 20)
FE -> GC : POST /api/examens/{id}/grades [{studentId, score}]
GC -> GS : saveGrades(examId, notes, teacherId)
GS -> TAR : existsByTeacherAndModule(teacherId, module)
alt enseignant non affecté à ce module
  GS --> GC : AccessDeniedException
  GC --> FE : 403 Forbidden
else enseignant autorisé
  alt note hors de l'intervalle 0 à 20
    GS --> GC : ValidationException
    GC --> FE : 400 Bad Request
  else notes valides
    GS -> GR : saveAll(notes au statut DRAFT)
    GR -> DB : INSERT ou UPDATE grades (unicité étudiant + évaluation)
    GS -> AU : log(GRADE_UPDATE)
    GC --> FE : 200 OK
  end
end
T -> FE : clique sur « Publier les notes »
FE -> GC : PUT /api/examens/{id}/grades/publish
GC -> GS : publish(examId, teacherId)
GS -> GR : updateStatus(examId, PUBLISHED)
GR -> DB : UPDATE grades SET status = 'PUBLISHED'
GS -> AU : log(GRADE_PUBLISH)
GC --> FE : 200 OK

== Consultation (étudiant) ==
E -> FE : ouvre « Mes résultats »
FE -> GC : GET /api/students/me/grades?year=2026-2027
GC -> GS : findPublishedByStudent(userId, année)
GS -> GR : findPublished(studentId, année)
GR -> DB : SELECT grades PUBLISHED + vue v_student_module_averages
GC --> FE : notes publiées et moyennes par module
FE --> E : affiche les résultats
@enduml
