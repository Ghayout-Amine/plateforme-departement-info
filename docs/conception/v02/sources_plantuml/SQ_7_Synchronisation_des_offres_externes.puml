@startuml
title Séquence — Synchronisation planifiée des offres externes (sources CACHED)
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #37474F
skinparam sequenceArrowThickness 1.1
skinparam participantBackgroundColor #E3F2FD
skinparam participantBorderColor #1565C0
skinparam actorBackgroundColor #E3F2FD
skinparam actorBorderColor #1565C0
skinparam boundaryBackgroundColor #E8F5E9
skinparam controlBackgroundColor #FFF8E1
skinparam databaseBackgroundColor #FFF3E0
skinparam sequenceGroupBackgroundColor #F5F5F5
skinparam sequenceDividerBackgroundColor #ECEFF1
skinparam noteBackgroundColor #FFF8E1
skinparam maxMessageSize 220
skinparam entityBackgroundColor #F3E5F5
skinparam entityBorderColor #6A1B9A
autonumber
participant "OfferSyncScheduler\n(@Scheduled)" as SCH
control "OfferSyncService" as OS
participant "JobSourceRepository" as SR
participant "JobProvider\n(ex. JoobleProvider)" as JP
entity "API externe\n(Jooble, JSearch,\nFrance Travail…)" as API
participant "OfferNormalizer" as NZ
participant "ExternalOfferRepository" as OR
participant "SyncLogRepository" as LR
participant "AlertService" as AL
database "MySQL" as DB

SCH -> OS : runDueSources() (toutes les 15 min)
OS -> SR : findEnabledByAccessMode(CACHED)
SR -> DB : SELECT job_sources
loop pour chaque source dont l'intervalle est écoulé
  OS -> LR : save(SyncLog RUNNING)
  OS -> OS : vérifie le quota restant
  alt quota épuisé
    OS -> LR : update(PARTIAL, « quota atteint »)
  else quota disponible
    loop pour chaque mot-clé × localisation configurés
      OS -> JP : search(criteria)
      JP -> API : GET/POST (clé lue dans la variable d'environnement apiKeyRef)
      alt API indisponible / délai dépassé
        API --> JP : erreur ou timeout
        JP --> OS : ProviderUnavailableException (après nouvelle tentative)
        note right of OS : coupe-circuit Resilience4j :\nles offres en cache restent affichées
      else réponse reçue
        API --> JP : liste d'offres (JSON)
        JP --> OS : List<ExternalOfferDto>
        OS -> NZ : normalize(dto)
        NZ --> OS : contrat normalisé (STAGE→INTERNSHIP, CDI…),\npays ISO, HTML nettoyé, empreinte SHA-256
        OS -> OR : findBySourceAndExternalId / findByFingerprint
        alt offre inconnue
          OS -> OR : save(ExternalOffer ACTIVE)
          OR -> DB : INSERT external_offers
        else offre déjà connue
          OS -> OR : markSeen(lastSeenAt = maintenant)
          OR -> DB : UPDATE external_offers
        end
      end
    end
    OS -> OR : expireNotSeenSince(source, rétention)
    OR -> DB : UPDATE external_offers SET status = 'EXPIRED'
    OS -> LR : update(SUCCESS ou PARTIAL, compteurs, quotaRemaining)
    LR -> DB : UPDATE sync_logs
  end
end
OS -> AL : notifyMatchingAlerts(nouvelles offres)
AL -> DB : SELECT saved_searches actives
AL -> AL : envoie un email récapitulatif par étudiant concerné
@enduml
