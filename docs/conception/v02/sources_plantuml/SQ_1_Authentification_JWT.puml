@startuml
title Séquence — Authentification (connexion avec jeton JWT)
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #37474F
skinparam sequenceArrowThickness 1.1
skinparam participantBackgroundColor #E3F2FD
skinparam participantBorderColor #1565C0
skinparam actorBackgroundColor #E3F2FD
skinparam actorBorderColor #1565C0
skinparam boundaryBackgroundColor #E8F5E9
skinparam controlBackgroundColor #FFF8E1
skinparam databaseBackgroundColor #FFF3E0
skinparam sequenceGroupBackgroundColor #F5F5F5
skinparam sequenceDividerBackgroundColor #ECEFF1
skinparam noteBackgroundColor #FFF8E1
skinparam maxMessageSize 220
autonumber

actor "Utilisateur" as U
boundary "Angular\n(LoginComponent)" as FE
control "AuthController" as AC
control "AuthService" as AS
participant "UserRepository" as UR
participant "PasswordEncoder\n(BCrypt)" as PE
participant "JwtService" as JW
participant "TokenRepository" as TR
participant "AuditService" as AU
database "MySQL" as DB

U -> FE : saisit son email et son mot de passe
FE -> AC : POST /api/auth/login {email, password}
AC -> AS : authenticate(request)
AS -> UR : findByEmail(email)
UR -> DB : SELECT users + user_roles + roles
DB --> UR : utilisateur (ou aucun résultat)
UR --> AS : utilisateur
alt utilisateur introuvable, compte désactivé ou supprimé
  AS -> AU : log(LOGIN_FAILED, email)
  AS --> AC : BadCredentialsException
  AC --> FE : 401 Unauthorized (message générique)
  FE --> U : « Identifiants invalides »
else compte actif
  AS -> PE : matches(password, passwordHash)
  alt mot de passe incorrect
    PE --> AS : false
    AS -> AU : log(LOGIN_FAILED, userId)
    AS --> AC : BadCredentialsException
    AC --> FE : 401 Unauthorized
    FE --> U : « Identifiants invalides »
  else mot de passe correct
    PE --> AS : true
    AS -> JW : generateAccessToken(user, rôles)
    JW --> AS : accessToken (JWT signé)
    AS -> JW : generateRefreshToken(user)
    AS -> TR : save(UserToken REFRESH, empreinte du jeton, expiresAt)
    TR -> DB : INSERT user_tokens
    AS -> UR : updateLastLogin(userId)
    UR -> DB : UPDATE users SET last_login_at
    AS -> AU : log(LOGIN, userId)
    AS --> AC : AuthResponse(accessToken, refreshToken, rôles)
    AC --> FE : 200 OK
    FE -> FE : mémorise le jeton, redirige selon le rôle\n(Étudiant, Enseignant, Responsable, Admin, Entreprise)
    FE --> U : affiche l'espace correspondant
  end
end
@enduml
