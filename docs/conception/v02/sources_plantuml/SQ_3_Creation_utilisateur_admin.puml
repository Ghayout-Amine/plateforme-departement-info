@startuml
title Séquence — Création d'un utilisateur par l'administrateur
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #37474F
skinparam sequenceArrowThickness 1.1
skinparam participantBackgroundColor #E3F2FD
skinparam participantBorderColor #1565C0
skinparam actorBackgroundColor #E3F2FD
skinparam actorBorderColor #1565C0
skinparam boundaryBackgroundColor #E8F5E9
skinparam controlBackgroundColor #FFF8E1
skinparam databaseBackgroundColor #FFF3E0
skinparam sequenceGroupBackgroundColor #F5F5F5
skinparam sequenceDividerBackgroundColor #ECEFF1
skinparam noteBackgroundColor #FFF8E1
skinparam maxMessageSize 220
autonumber

actor "Administrateur" as A
boundary "Angular" as FE
participant "JwtAuthFilter\n(Spring Security)" as JF
control "UserController" as UC
control "UserService" as US
participant "UserRepository" as UR
participant "RoleRepository" as RR
participant "MailService" as MS
participant "AuditService" as AU
database "MySQL" as DB

A -> FE : remplit le formulaire (email, nom, prénom, rôles)
FE -> JF : POST /api/admin/users + en-tête Authorization: Bearer JWT
JF -> JF : vérifie la signature et l'expiration du jeton
alt jeton invalide ou expiré
  JF --> FE : 401 Unauthorized
else jeton valide
  JF -> UC : requête authentifiée
  UC -> UC : @PreAuthorize(ROLE_ADMIN)
  alt rôle insuffisant
    UC --> FE : 403 Forbidden
  else rôle ADMIN
    UC -> US : createUser(dto)
    US -> UR : existsByEmail(email)
    UR -> DB : SELECT COUNT(*) FROM users WHERE email = ?
    alt email déjà utilisé
      US --> UC : DuplicateEmailException
      UC --> FE : 409 Conflict
    else email disponible
      US -> RR : findByNameIn(rôles demandés)
      RR -> DB : SELECT roles
      US -> US : génère un mot de passe temporaire et le hache (BCrypt)
      US -> UR : save(utilisateur + rôles)
      UR -> DB : INSERT users, user_roles
      US -> MS : sendAccountCreated(email, lien de définition du mot de passe)
      US -> AU : log(CREATE_USER, adminId, userId)
      US --> UC : UserResponse
      UC --> FE : 201 Created
      FE --> A : « Utilisateur créé »
    end
  end
end
@enduml
