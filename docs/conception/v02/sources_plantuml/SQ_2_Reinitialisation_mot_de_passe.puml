@startuml
title Séquence — Réinitialisation du mot de passe
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #37474F
skinparam sequenceArrowThickness 1.1
skinparam participantBackgroundColor #E3F2FD
skinparam participantBorderColor #1565C0
skinparam actorBackgroundColor #E3F2FD
skinparam actorBorderColor #1565C0
skinparam boundaryBackgroundColor #E8F5E9
skinparam controlBackgroundColor #FFF8E1
skinparam databaseBackgroundColor #FFF3E0
skinparam sequenceGroupBackgroundColor #F5F5F5
skinparam sequenceDividerBackgroundColor #ECEFF1
skinparam noteBackgroundColor #FFF8E1
skinparam maxMessageSize 220
autonumber

actor "Utilisateur" as U
boundary "Angular" as FE
control "AuthController" as AC
control "AuthService" as AS
participant "UserRepository" as UR
participant "TokenRepository" as TR
participant "PasswordEncoder" as PE
participant "MailService\n(SMTP)" as MS
participant "AuditService" as AU
database "MySQL" as DB

== Demande de réinitialisation ==
U -> FE : clique sur « Mot de passe oublié » et saisit son email
FE -> AC : POST /api/auth/forgot-password {email}
AC -> AS : requestPasswordReset(email)
AS -> UR : findByEmail(email)
UR -> DB : SELECT users
opt compte actif trouvé
  AS -> AS : génère un jeton aléatoire (valable 30 minutes)
  AS -> TR : save(UserToken PASSWORD_RESET, empreinte du jeton, expiresAt)
  TR -> DB : INSERT user_tokens
  AS -> MS : sendResetLink(email, jeton)
  MS --> U : email contenant le lien de réinitialisation
end
AC --> FE : 200 OK (même réponse dans tous les cas)
FE --> U : « Si ce compte existe, un email a été envoyé »

== Choix du nouveau mot de passe ==
U -> FE : ouvre le lien et saisit le nouveau mot de passe
FE -> AC : POST /api/auth/reset-password {jeton, newPassword}
AC -> AS : resetPassword(jeton, newPassword)
AS -> TR : findValidByHash(empreinte, PASSWORD_RESET)
TR -> DB : SELECT user_tokens WHERE revoked_at IS NULL AND expires_at > NOW()
alt jeton invalide, expiré ou déjà utilisé
  AS --> AC : InvalidTokenException
  AC --> FE : 400 Bad Request
  FE --> U : « Lien invalide ou expiré »
else jeton valide
  AS -> PE : encode(newPassword)
  AS -> UR : updatePassword(userId, hash)
  UR -> DB : UPDATE users SET password_hash
  AS -> TR : revokeAll(userId)
  TR -> DB : UPDATE user_tokens SET revoked_at = NOW()
  AS -> AU : log(PASSWORD_RESET, userId)
  AC --> FE : 200 OK
  FE --> U : « Mot de passe modifié, veuillez vous reconnecter »
end
@enduml
