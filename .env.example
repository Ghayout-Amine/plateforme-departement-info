# Copier ce fichier en .env (non commité) puis renseigner les clés.
# PGDI2026-86 : offres de stage externes
# Jooble : clé gratuite reçue par e-mail sur https://jooble.org/api/about
#   (une clé correspond au site Jooble d'un pays : demander la clé depuis ma.jooble.org pour le Maroc)
JOOBLE_API_KEY=
# JSearch (RapidAPI, facultatif) : https://rapidapi.com → JSearch → clé X-RapidAPI-Key
JSEARCH_API_KEY=
